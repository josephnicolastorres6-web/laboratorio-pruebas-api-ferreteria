  "item": [
    {
      "name": "1.Autenticacion Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Aserción 1: Validar que el servidor responda con un 200 OK\r",
              "pm.test(\"Estado HTTP es 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Aserción 2: Validar rendimiento (respuesta rápida)\r",
              "pm.test(\"Tiempo de respuesta inferior a 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "// Aserción 3: Guardar automáticamente el token recibido\r",
              "pm.test(\"Token guardado exitosamente en la variable\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.environment.set(\"user_token\", jsonData.token);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
