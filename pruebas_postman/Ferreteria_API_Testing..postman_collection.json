    {
      "name": "2. Consultar Productos y cambia el método a GET",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Aserción 1: Validar código de estado HTTP 200 OK\r",
              "pm.test(\"Estado HTTP es 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Aserción 2: Definir y validar el contrato JSON Schema\r",
              "const schema = {\r",
              "    \"type\": \"array\",\r",
              "    \"items\": {\r",
              "        \"type\": \"object\",\r",
              "        \"required\": [\"id\", \"nombre\", \"codigo\", \"precio_base\", \"stock\", \"precio_final\"],\r",
              "        \"properties\": {\r",
              "            \"id\": { \"type\": \"number\" },\r",
              "            \"nombre\": { \"type\": \"string\" },\r",
              "            \"codigo\": { \"type\": \"string\" },\r",
              "            \"precio_base\": { \"type\": \"string\" },\r",
              "            \"stock\": { \"type\": \"number\" },\r",
              "            \"precio_final\": { \"type\": \"number\" }\r",
              "        }\r",
              "    }\r",
              "};\r",
              "\r",
              "pm.test(\"El contrato del esquema JSON es válido\", function () {\r",
              "    pm.response.to.have.jsonSchema(schema);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
